// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

// =======================
// ENUMS
// =======================

enum GlobalRole {
  USER
  SUPERADMIN
}

enum TeamRole {
  OWNER
  EDITOR
  VIEWER
}

// 🔥 НОВОЕ: Планы подписки для команд
enum Plan {
  FREE
  PRO
}

// =======================
// MODELS
// =======================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  username      String?   @unique  // Для ссылок вида @alex
  phone         String?            // На будущее
  firstName     String?            // На будущее
  lastName      String?            // На будущее
  
  globalRole    GlobalRole @default(USER)

  accounts      Account[]
  sessions      Session[]
  teams         TeamMember[] 
  feedbacks     Feedback[]
  comments      Comment[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastLogin     DateTime? @default(now())
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String? @db.Text
  access_token       String? @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String? @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Team {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  avatarUrl   String?
  
  // 🔥 НОВОЕ: Поле подписки
  plan        Plan     @default(FREE)
  
  members     TeamMember[]
  projects    Project[]
  invitations TeamInvitation[]  // 🔥 ДОБАВЛЕНО: обратная связь

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model TeamMember {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  role      TeamRole @default(VIEWER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, teamId])
}

model Project {
  id                 String    @id @default(cuid())
  name               String    @unique
  description        String?
  gitUrl             String    
  repoId             Int?
  branch             String    @default("main")
  repoOwner          String?
  gitToken           String?   @db.Text 
  yandexContainerId  String?

  domain             String?   @unique
  screenshot         String?
  isPublic           Boolean   @default(false)
  autodeploy         Boolean   @default(true)
  status             String    @default("created")
  lastDeployed       DateTime?

  // 🔥 Ресурсы для Yandex Serverless Containers
  cpu                Float     @default(1)        // vCPU: 0.5, 1, 2, 4
  memory             Int       @default(512)      // RAM в MB: 128-8192
  minInstances       Int       @default(0)        // Подготовленные инстансы (0 = cold start)
  concurrency        Int       @default(1)        // Одновременных запросов на инстанс (1-16)

  // 🔥 НОВОЕ: Стек технологий
  framework          String?
  builder            String?
  language           String?

  envVars            Json?
  teamId             String
  team               Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  
  webhookId          Int?
  deployments        Deployment[] 
  domains            Domain[]
  
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Deployment {
  id            String   @id @default(cuid())
  status        String   
  image         String?
  
  initiator     String?
  branch        String?  
  commitShort   String?
  commitSha     String?
  commitMessage String?
  imageTag      String?
  yandexImageId String?
  revisionId    String?
  
  logs          String?  @db.Text
  
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  createdAt     DateTime @default(now())
}

model Domain {
  id            String   @id @default(cuid())
  name          String   
  certId        String?
  gatewayId     String?
  serviceDomain String?
  zoneId        String?
  
  status        String   @default("validating_dns")
  dnsConfigured Boolean  @default(false)
  cdnEnabled    Boolean  @default(false)
  cdnCertId     String?
  
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Feedback {
  id        String   @id @default(cuid())
  name      String?
  slug      String?  @unique
  type      String   // 'bug', 'feature', 'question'
  title     String?  // Заголовок для форума
  message   String   // Текст сообщения
  email     String?
  
  status    String   @default("new") // 'new', 'in_progress', 'completed'
  isPublic  Boolean  @default(false) // Флаг для форума

  views     Int      @default(0)

  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  comments  Comment[] // Связь с комментариями

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isPublic, createdAt]) 
  @@index([isPublic, type])      
  @@index([userId])              
  @@index([status])
  @@index([slug])
}

model Comment {
  id         String   @id @default(cuid())
  message    String   @db.Text
  
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // 🔥 ПОЛЯ ДЛЯ ГОСТЯ
  name       String? 
  email      String?

  feedbackId String
  feedback   Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([feedbackId])
  @@index([userId])
}

model TeamInvitation {
  id         String   @id @default(cuid())
  email      String
  teamId     String
  team       Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  role       TeamRole @default(VIEWER)
  invitedBy  String   // email того, кто пригласил
  createdAt  DateTime @default(now())
  expiresAt  DateTime @default(dbgenerated("(NOW() + INTERVAL '7 DAY')"))

  @@unique([email, teamId])
  @@index([email])
  @@index([teamId])
}