// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// =======================
// ENUMS
// =======================

enum DeploymentType {
  SERVERLESS
  VM
}

enum GlobalRole {
  USER
  SUPERADMIN
}

enum TeamRole {
  OWNER
  EDITOR
  VIEWER
}

enum Plan {
  FREE
  PRO
  ADMIN    // Тариф "Админка" 2000₽
  BUSINESS // Тариф "Business" от 2990₽
  DONATE
}

// =======================
// MODELS
// =======================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  username      String?   @unique  
  phone         String?            
  firstName     String?            
  lastName      String?            
  
  globalRole    GlobalRole @default(USER)

  accounts      Account[]
  sessions      Session[]
  teams         TeamMember[] 
  feedbacks     Feedback[]
  comments      Comment[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastLogin     DateTime? @default(now())
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String? @db.Text
  access_token       String? @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String? @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Team {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  avatarUrl   String?
  
  plan        Plan     @default(FREE) // 🔥 ИСПРАВЛЕНО ТУТ

  dbHost        String?   
  dbRootPassEnc    String?   
  planExpiresAt  DateTime?          
  planOrderId    String?            
  payments       Payment[]
  
  members     TeamMember[]
  projects    Project[]
  invitations TeamInvitation[]  

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model TeamMember {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  role      TeamRole @default(VIEWER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, teamId])
}

model Project {
  id                 String    @id @default(cuid())
  name               String    @unique
  description        String?
  gitUrl             String    
  repoId             Int?
  branch             String    @default("main")
  repoOwner          String?
  gitToken           String?   @db.Text 

  // 🔥 НОВЫЕ ПОЛЯ ДЛЯ БД
  hasDatabase        Boolean   @default(false)
  dbName             String?   // имя БД внутри кластера команды
  dbUser             String?   // имя Postgres-пользователя
  dbHost             String?   // дублируем team.dbHost сюда для удобства чтения
  dbPasswordEnc      String?   // зашифрованный пароль юзера БД (AES-256-GCM)
  yandexContainerId  String?

  domain             String?   @unique
  screenshot         String?
  isPublic           Boolean   @default(false)
  autodeploy         Boolean   @default(true)
  status             String    @default("created")
  lastDeployed       DateTime?

  cpu                Float     @default(1)        
  memory             Int       @default(512)      
  minInstances       Int       @default(0)        
  concurrency        Int       @default(1)        

  framework          String?
  builder            String?
  language           String?
  
  sourceType         String?   

  envVars            Json?
  teamId             String
  team               Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  
  webhookId          Int?
  deployments        Deployment[] 
  domains            Domain[]
  
  deploymentType     DeploymentType @default(SERVERLESS)
  
  vmContainerName    String?   
  vmHost             String?   
  vmStatus           String?   
  vmLastSeen         DateTime? 

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Deployment {
  id            String   @id @default(cuid())
  status        String   
  image         String?
  
  initiator     String?
  branch        String?  
  commitShort   String?
  commitSha     String?
  commitMessage String?
  imageTag      String?
  yandexImageId String?
  revisionId    String?
  
  logs          String?  @db.Text
  
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  deploymentType     DeploymentType @default(SERVERLESS)

  createdAt     DateTime @default(now())
}

model Domain {
  id            String   @id @default(cuid())
  name          String   
  certId        String?
  gatewayId     String?
  serviceDomain String?
  zoneId        String?
  
  status        String   @default("validating_dns")
  dnsConfigured Boolean  @default(false)
  cdnEnabled    Boolean  @default(false)
  cdnCertId     String?
  
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Feedback {
  id        String   @id @default(cuid())
  name      String?
  slug      String?  @unique
  type      String   // 'bug', 'feature', 'question'
  title     String?  // Заголовок для форума
  message   String   // Текст сообщения
  email     String?
  
  status    String   @default("new") // 'new', 'in_progress', 'completed'
  isPublic  Boolean  @default(false) // Флаг для форума

  views     Int      @default(0)

  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  comments  Comment[] 

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isPublic, createdAt]) 
  @@index([isPublic, type])      
  @@index([userId])              
  @@index([status])
  @@index([slug])
}

model Comment {
  id         String   @id @default(cuid())
  message    String   @db.Text
  
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  name       String? 
  email      String?

  feedbackId String
  feedback   Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([feedbackId])
  @@index([userId])
}

model TeamInvitation {
  id         String   @id @default(cuid())
  email      String
  teamId     String
  team       Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  role       TeamRole @default(VIEWER)
  invitedBy  String   
  createdAt  DateTime @default(now())
  expiresAt  DateTime @default(dbgenerated("(NOW() + INTERVAL '7 DAY')"))

  @@unique([email, teamId])
  @@index([email])
  @@index([teamId])
}

model Payment {
  id              String   @id @default(cuid())

  teamId          String
  team            Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  alfaOrderId     String?  @unique  
  alfaFormUrl     String?           

  plan            Plan              
  amount          Int               
  currency        String   @default("RUB")

  status          String   @default("pending")
  // pending   - создан, ждём оплаты
  // paid      - оплачен (callback от банка)
  // failed    - не оплачен
  // cancelled - отменён

  bankOrderStatus Int?              
  bankMessage     String?

  periodStart     DateTime?
  periodEnd       DateTime?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([teamId])
  @@index([alfaOrderId])
  @@index([status])
}